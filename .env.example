# Copy this file to .env and fill in real values. .env is gitignored; this
# file is the template that stays in version control.
#
# VITE_GCAL_ID  — the calendar's ID from Settings and sharing > Integrate
#                 calendar. Looks like an email address, not the display name.
# VITE_GCAL_KEY — an API key from Google Cloud Console with the Calendar API
#                 enabled, restricted to this site's domain under
#                 Application restrictions > HTTP referrers.
VITE_GCAL_ID=
VITE_GCAL_KEY=
# VITE_GDRIVE_FOLDER — the id of a public Google Drive folder of photos, taken
#                      from its URL: drive.google.com/drive/folders/<this part>.
#                      Uses the same API key, with the Drive API enabled too.
VITE_GDRIVE_FOLDER=
# VITE_GDRIVE_KEY    — a key cleared for the Drive API. A Google API key can be
#                      restricted to particular APIs, so the calendar key will
#                      not work here unless Drive is on its allowed list.
VITE_GDRIVE_KEY=# VITE_ACCOUNTS_BACKEND � 'local' keeps member accounts in each browser only.
#                        'supabase' is reserved for the switch described in src/lib/accounts.ts.
VITE_ACCOUNTS_BACKEND=local
